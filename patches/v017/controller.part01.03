+        a->repeatGapMs = std::clamp(_wtoi(GetText(actionRepeatGap_).c_str()), 0, 60000);
+        a->atomicLease = SendMessageW(actionAtomic_, BM_GETCHECK, 0, 0) == BST_CHECKED;
