+
+ActionStep LegacyStep(const wchar_t* name, const ScreenPoint& source) {
+    ActionStep step{};
+    step.name = name;
+    step.point = source;
+    step.point.beforeDelayMs = 0;
+    step.point.repeatGapMs = std::max(0, source.delayMs);
+    return step;
+}
+
+NamedAction MakeAction(int id, const wchar_t* name, std::initializer_list<ActionStep> steps,
+                       bool accountOverride = false) {
+    NamedAction action{};
+    action.id = id;
+    action.name = name;
+    action.useAccountPointOverride = accountOverride;
+    action.steps.assign(steps.begin(), steps.end());
+    return action;
+}
+
+AutomationModel BuildDefaultAutomationModel(const SharedSettings& legacy) {
+    AutomationModel m{};
+    int aid = 1;
+    const int reviveId = aid++;
+    const int confirmId = aid++;
+    const int treatId = aid++;
+    const int buffId = aid++;
+    const int closeTreatId = aid++;
+    const int pkAllianceId = aid++;
+    const int autoPkId = aid++;
+    const int autoTrainId = aid++;
+
+    m.actions.push_back(MakeAction(reviveId, L"ĐẦU THAI", {
+        LegacyStep(kSlotLabels[kReviveSlot], legacy.clicks[kReviveSlot])
+    }));
+    m.actions.push_back(MakeAction(confirmId, L"XÁC NHẬN RA MAP", {
+        LegacyStep(kSlotLabels[kSemanticConfirmSlot], legacy.clicks[kSemanticConfirmSlot])
+    }, true));
+    m.actions.push_back(MakeAction(treatId, L"TRỊ LIỆU", {
+        LegacyStep(kSlotLabels[2], legacy.clicks[2]),
+        LegacyStep(kSlotLabels[3], legacy.clicks[3]),
+        LegacyStep(kSlotLabels[4], legacy.clicks[4]),
+        LegacyStep(kSlotLabels[5], legacy.clicks[5])
+    }));
+    m.actions.push_back(MakeAction(buffId, L"BUFF", {
+        LegacyStep(kSlotLabels[6], legacy.clicks[6])
+    }));
+    m.actions.push_back(MakeAction(closeTreatId, L"ĐÓNG BẢNG TRỊ LIỆU", {
+        LegacyStep(kSlotLabels[7], legacy.clicks[7]),
+        LegacyStep(kSlotLabels[8], legacy.clicks[8]),
+        LegacyStep(kSlotLabels[9], legacy.clicks[9])
+    }));
+    m.actions.push_back(MakeAction(pkAllianceId, L"PK LIÊN MINH", {
+        LegacyStep(kSlotLabels[10], legacy.clicks[10]),
+        LegacyStep(kSlotLabels[11], legacy.clicks[11])
+    }));
+    m.actions.push_back(MakeAction(autoPkId, L"AUTO PK", {
+        LegacyStep(kSlotLabels[12], legacy.clicks[12]),
+        LegacyStep(kSlotLabels[13], legacy.clicks[13]),
+        LegacyStep(kSlotLabels[14], legacy.clicks[14])
+    }));
+    m.actions.push_back(MakeAction(autoTrainId, L"AUTO TRAIN", {
+        LegacyStep(kSlotLabels[15], legacy.clicks[15])
+    }));
+
+    int wid = 1;
+    WorkflowDefinition reviveW{wid++, L"FSM • HỒI SINH", true, {reviveId}};
+    WorkflowDefinition recoveryW{wid++, L"FSM • TRỊ LIỆU", true, {treatId}};
+    if (legacy.buffEnabled) recoveryW.actionIds.push_back(buffId);
+    recoveryW.actionIds.push_back(closeTreatId);
+    WorkflowDefinition stageW{wid++, L"FSM • PK LIÊN MINH", true, {pkAllianceId}};
+    WorkflowDefinition finalW{wid++, L"FSM • AUTO PK + TRAIN", true, {autoPkId, autoTrainId}};
+    WorkflowDefinition confirmW{wid++, L"FSM • XN RA MAP", true, {confirmId}};
+    m.reviveWorkflowId = reviveW.id;
+    m.recoveryWorkflowId = recoveryW.id;
+    m.stageWorkflowId = stageW.id;
+    m.finalWorkflowId = finalW.id;
+    m.confirmWorkflowId = confirmW.id;
+    m.workflows = {reviveW, recoveryW, stageW, finalW, confirmW};
+    m.nextActionId = aid;
+    m.nextWorkflowId = wid;
+    return m;
+}
+
+void SaveAutomationModel(const AutomationModel& m) {
+    EnsureUnicodeIni();
+    const std::wstring root = L"Automation";
+    WriteIniIntSection(root, L"Version", 1);
+    WriteIniIntSection(root, L"ActionCount", static_cast<int>(m.actions.size()));
+    WriteIniIntSection(root, L"WorkflowCount", static_cast<int>(m.workflows.size()));
+    WriteIniIntSection(root, L"NextActionId", std::max(1, m.nextActionId));
+    WriteIniIntSection(root, L"NextWorkflowId", std::max(1, m.nextWorkflowId));
+    WriteIniIntSection(root, L"ReviveWorkflowId", m.reviveWorkflowId);
+    WriteIniIntSection(root, L"RecoveryWorkflowId", m.recoveryWorkflowId);
+    WriteIniIntSection(root, L"StageWorkflowId", m.stageWorkflowId);
+    WriteIniIntSection(root, L"FinalWorkflowId", m.finalWorkflowId);
+    WriteIniIntSection(root, L"ConfirmWorkflowId", m.confirmWorkflowId);
+
+    for (std::size_t i = 0; i < m.actions.size(); ++i) {
+        const NamedAction& a = m.actions[i];
+        WriteIniIntSection(root, (L"ActionId" + std::to_wstring(i)).c_str(), a.id);
+        const std::wstring sec = L"Action." + std::to_wstring(a.id);
+        WritePrivateProfileStringW(sec.c_str(), L"Name", a.name.c_str(), ConfigPath().c_str());
+        WriteIniIntSection(sec, L"BeforeMs", std::clamp(a.beforeDelayMs, 0, 60000));
+        WriteIniIntSection(sec, L"AfterMs", std::clamp(a.afterDelayMs, 0, 60000));
+        WriteIniIntSection(sec, L"Repeat", std::clamp(a.repeat, 1, 100));
+        WriteIniIntSection(sec, L"RepeatGapMs", std::clamp(a.repeatGapMs, 0, 60000));
+        WriteIniIntSection(sec, L"AtomicLease", a.atomicLease ? 1 : 0);
+        WriteIniIntSection(sec, L"AccountPointOverride", a.useAccountPointOverride ? 1 : 0);
+        WriteIniIntSection(sec, L"StepCount", static_cast<int>(a.steps.size()));
+        for (std::size_t j = 0; j < a.steps.size(); ++j) {
+            const ActionStep& s = a.steps[j];
+            const ScreenPoint& p = s.point;
+            const std::wstring ssec = sec + L".Step." + std::to_wstring(j);
+            WritePrivateProfileStringW(ssec.c_str(), L"Name", s.name.c_str(), ConfigPath().c_str());
+            WriteIniIntSection(ssec, L"X", p.valid ? p.x : -1);
+            WriteIniIntSection(ssec, L"Y", p.valid ? p.y : -1);
+            WriteIniIntSection(ssec, L"W", p.valid ? p.baseW : 0);
+            WriteIniIntSection(ssec, L"H", p.valid ? p.baseH : 0);
+            WriteIniIntSection(ssec, L"Enabled", p.enabled ? 1 : 0);
+            WriteIniIntSection(ssec, L"BeforeMs", std::clamp(p.beforeDelayMs, 0, 60000));
+            WriteIniIntSection(ssec, L"AfterMs", std::clamp(p.delayMs, 0, 60000));
+            WriteIniIntSection(ssec, L"Repeat", std::clamp(p.repeat, 1, 100));
+            WriteIniIntSection(ssec, L"RepeatGapMs", std::clamp(p.repeatGapMs, 0, 60000));
+        }
+    }
+
+    for (std::size_t i = 0; i < m.workflows.size(); ++i) {
+        const WorkflowDefinition& w = m.workflows[i];
+        WriteIniIntSection(root, (L"WorkflowId" + std::to_wstring(i)).c_str(), w.id);
+        const std::wstring sec = L"Workflow." + std::to_wstring(w.id);
+        WritePrivateProfileStringW(sec.c_str(), L"Name", w.name.c_str(), ConfigPath().c_str());
+        WriteIniIntSection(sec, L"Reserved", w.reserved ? 1 : 0);
+        WriteIniIntSection(sec, L"ItemCount", static_cast<int>(w.actionIds.size()));
+        for (std::size_t j = 0; j < w.actionIds.size(); ++j)
+            WriteIniIntSection(sec, (L"ActionId" + std::to_wstring(j)).c_str(), w.actionIds[j]);
+    }
+    FlushIni();
+}
+
+AutomationModel LoadAutomationModel(const SharedSettings& legacy) {
+    const std::wstring root = L"Automation";
+    const int version = ReadIniIntSection(root, L"Version", 0);
+    const int actionCount = std::clamp(ReadIniIntSection(root, L"ActionCount", 0), 0, 500);
+    const int workflowCount = std::clamp(ReadIniIntSection(root, L"WorkflowCount", 0), 0, 200);
+    if (version <= 0 || actionCount <= 0 || workflowCount <= 0) {
+        AutomationModel migrated = BuildDefaultAutomationModel(legacy);
+        SaveAutomationModel(migrated);
+        return migrated;
+    }
+
+    AutomationModel m{};
+    m.nextActionId = std::max(1, ReadIniIntSection(root, L"NextActionId", 1));
+    m.nextWorkflowId = std::max(1, ReadIniIntSection(root, L"NextWorkflowId", 1));
+    m.reviveWorkflowId = ReadIniIntSection(root, L"ReviveWorkflowId", 0);
+    m.recoveryWorkflowId = ReadIniIntSection(root, L"RecoveryWorkflowId", 0);
+    m.stageWorkflowId = ReadIniIntSection(root, L"StageWorkflowId", 0);
+    m.finalWorkflowId = ReadIniIntSection(root, L"FinalWorkflowId", 0);
+    m.confirmWorkflowId = ReadIniIntSection(root, L"ConfirmWorkflowId", 0);
+
+    for (int i = 0; i < actionCount; ++i) {
+        const int id = ReadIniIntSection(root, (L"ActionId" + std::to_wstring(i)).c_str(), 0);
+        if (id <= 0) continue;
+        const std::wstring sec = L"Action." + std::to_wstring(id);
+        NamedAction a{};
+        a.id = id;
+        a.name = ReadIniStringSection(sec, L"Name");
+        if (a.name.empty()) a.name = L"ACTION " + std::to_wstring(id);
+        a.beforeDelayMs = std::clamp(ReadIniIntSection(sec, L"BeforeMs", 0), 0, 60000);
+        a.afterDelayMs = std::clamp(ReadIniIntSection(sec, L"AfterMs", 0), 0, 60000);
+        a.repeat = std::clamp(ReadIniIntSection(sec, L"Repeat", 1), 1, 100);
+        a.repeatGapMs = std::clamp(ReadIniIntSection(sec, L"RepeatGapMs", 250), 0, 60000);
+        a.atomicLease = ReadIniIntSection(sec, L"AtomicLease", 1) != 0;
+        a.useAccountPointOverride = ReadIniIntSection(sec, L"AccountPointOverride", 0) != 0;
+        const int stepCount = std::clamp(ReadIniIntSection(sec, L"StepCount", 0), 0, 500);
+        for (int j = 0; j < stepCount; ++j) {
+            const std::wstring ssec = sec + L".Step." + std::to_wstring(j);
+            ActionStep s{};
+            s.name = ReadIniStringSection(ssec, L"Name");
+            if (s.name.empty()) s.name = L"Bước " + std::to_wstring(j + 1);
+            ScreenPoint& p = s.point;
+            p.x = ReadIniIntSection(ssec, L"X", -1);
+            p.y = ReadIniIntSection(ssec, L"Y", -1);
+            p.baseW = ReadIniIntSection(ssec, L"W", 0);
+            p.baseH = ReadIniIntSection(ssec, L"H", 0);
+            p.valid = p.x >= 0 && p.y >= 0 && p.baseW > 0 && p.baseH > 0;
+            p.enabled = ReadIniIntSection(ssec, L"Enabled", 1) != 0;
+            p.beforeDelayMs = std::clamp(ReadIniIntSection(ssec, L"BeforeMs", 0), 0, 60000);
+            p.delayMs = std::clamp(ReadIniIntSection(ssec, L"AfterMs", kDefaultClickDelayMs), 0, 60000);
+            p.repeat = std::clamp(ReadIniIntSection(ssec, L"Repeat", 1), 1, 100);
+            p.repeatGapMs = std::clamp(ReadIniIntSection(ssec, L"RepeatGapMs", 250), 0, 60000);
+            a.steps.push_back(std::move(s));
+        }
+        m.actions.push_back(std::move(a));
+    }
+
+    for (int i = 0; i < workflowCount; ++i) {
+        const int id = ReadIniIntSection(root, (L"WorkflowId" + std::to_wstring(i)).c_str(), 0);
+        if (id <= 0) continue;
+        const std::wstring sec = L"Workflow." + std::to_wstring(id);
+        WorkflowDefinition w{};
+        w.id = id;
+        w.name = ReadIniStringSection(sec, L"Name");
+        if (w.name.empty()) w.name = L"WORKFLOW " + std::to_wstring(id);
+        w.reserved = ReadIniIntSection(sec, L"Reserved", 0) != 0;
+        const int itemCount = std::clamp(ReadIniIntSection(sec, L"ItemCount", 0), 0, 1000);
+        for (int j = 0; j < itemCount; ++j) {
+            const int aid = ReadIniIntSection(sec, (L"ActionId" + std::to_wstring(j)).c_str(), 0);
+            if (aid > 0) w.actionIds.push_back(aid);
+        }
+        m.workflows.push_back(std::move(w));
+    }
+    if (m.actions.empty() || m.workflows.empty()) {
+        m = BuildDefaultAutomationModel(legacy);
+        SaveAutomationModel(m);
+    }
+    return m;
+}
