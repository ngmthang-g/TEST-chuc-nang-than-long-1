+
+    void ObservePhysicalMouse(WPARAM wp, const MSLLHOOKSTRUCT& info) {
+        if (info.flags & LLMHF_INJECTED) return;
+        const DWORD now = GetTickCount();
+        if (ownMouseIgnoreUntilTick_ && static_cast<LONG>(now - ownMouseIgnoreUntilTick_) < 0) return;
+        switch (wp) {
+            case WM_MOUSEMOVE:
+            case WM_LBUTTONDOWN:
+            case WM_LBUTTONUP:
+            case WM_RBUTTONDOWN:
+            case WM_RBUTTONUP:
+            case WM_MBUTTONDOWN:
+            case WM_MBUTTONUP:
+            case WM_MOUSEWHEEL:
+            case WM_MOUSEHWHEEL:
+            case WM_XBUTTONDOWN:
+            case WM_XBUTTONUP:
+                lastPhysicalMouseTick_ = now;
+                break;
+        }
+    }
+
+    bool UserMouseGuardActive(DWORD now, DWORD* remainingMs = nullptr) const {
+        if (!lastPhysicalMouseTick_) return false;
+        const DWORD elapsed = now - lastPhysicalMouseTick_;
+        if (elapsed >= kUserMouseGuardMs) return false;
+        if (remainingMs) *remainingMs = kUserMouseGuardMs - elapsed;
+        return true;
+    }
